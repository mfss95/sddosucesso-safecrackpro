# =============================================================================
# SafeCrack Pro - Configuracao do projeto Quartus (DE2-115)
# =============================================================================
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY safecrackpro_top

# Arquivos-fonte (caminhos relativos a esta pasta quartus/)
set_global_assignment -name SYSTEMVERILOG_FILE ../simulacao_modelsim/bcd_to_7segment_anodo.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../simulacao_modelsim/safecrackpro_fsm.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../simulacao_modelsim/safecrackpro_top.sv
set_global_assignment -name SDC_FILE safecrackpro.sdc

# Pinos nao usados (HEX5-HEX7, chaves, etc.) como entrada com pull-up fraco:
# evita que os segmentos de HEX5..HEX7 fiquem acesos/flutuando.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED WITH WEAK PULL-UP"

set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# ----------------------------------------------------------------------------
